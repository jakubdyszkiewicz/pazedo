#!/bin/sh
# Starts the dev build of pazedo, connected to the Paseo test daemon by default.
#
#   script/pazedo/run-dev [paths...]
#
# Stops any running dev instance first. The binary is copied into a minimal app bundle in
# .pazedo-dev/ (git-excluded) and started with `open`, so it runs as a regular app and `--env`
# can pass the endpoint. Where the bundle lives matters:
# - target/ is on the external disk, and an app started from a removable volume blocks in dyld
#   until someone answers macOS's "access files on a removable volume" prompt;
# - debug builds read their assets from the checkout, found by walking up from the executable
#   to a directory with .git, so the bundle must sit inside the repository.
# It may still start behind other windows; script/pazedo/screenshot raises it before capturing.
set -eu

repo=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
profile="${PAZEDO_PROFILE:-debug}"
binary="$repo/target/$profile/pazedo"
bundle="$repo/.pazedo-dev/PazedoDev.app"
endpoint="${PAZEDO_PASEO_ENDPOINT:-127.0.0.1:6868}"
# Pazedo.app uses the default folders (~/.config/pazedo, ~/Library/Application Support/Pazedo);
# a dev build running next to it must not share its settings and databases.
data_dir="${PAZEDO_USER_DATA_DIR:-$repo/.pazedo-dev/data}"
# Agents created from Zed use the test daemon's mock provider unless told otherwise.
provider="${PAZEDO_AGENT_PROVIDER:-mock}"
model="${PAZEDO_AGENT_MODEL:-one-minute-stream}"

if [ ! -x "$binary" ]; then
  echo "$binary not found; run cargo build -p zed first" >&2
  exit 1
fi

pkill -f "$bundle/Contents/MacOS/" 2>/dev/null && sleep 1 || true
grep -qx '/.pazedo-dev/' "$repo/.git/info/exclude" 2>/dev/null ||
  echo '/.pazedo-dev/' >> "$repo/.git/info/exclude"
rm -rf "$bundle"
mkdir -p "$bundle/Contents/MacOS" "$bundle/Contents/Resources"
cp "$binary" "$bundle/Contents/MacOS/pazedo"
iconset=$(mktemp -d)/Pazedo.iconset
mkdir -p "$iconset"
for size in 16 32 128 256 512; do
  sips -z "$size" "$size" "$repo/crates/zed/resources/app-icon-dev@2x.png" \
    --out "$iconset/icon_${size}x${size}.png" >/dev/null
  double=$((size * 2))
  sips -z "$double" "$double" "$repo/crates/zed/resources/app-icon-dev@2x.png" \
    --out "$iconset/icon_${size}x${size}@2x.png" >/dev/null
done
iconutil -c icns "$iconset" -o "$bundle/Contents/Resources/Pazedo.icns"
cat > "$bundle/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key><string>pazedo</string>
  <key>CFBundleIdentifier</key><string>dev.pazedo.dev</string>
  <key>CFBundleName</key><string>Pazedo Dev</string>
  <key>CFBundleIconFile</key><string>Pazedo</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
PLIST

# `open` passes no environment of its own; forward the optional overrides that are set.
# PAZEDO_PASEO_SSH puts the daemon's folders on an SSH host. A debug build then builds Zed's
# remote server from source unless ZED_BUILD_REMOTE_SERVER=false, which uses the one already
# installed there (see script/pazedo/remote-server).
extra_env=""
for name in PAZEDO_AGENT_HISTORY_LIMIT PAZEDO_PASEO_SSH ZED_BUILD_REMOTE_SERVER RUST_LOG; do
  eval "value=\${$name:-}"
  if [ -n "$value" ]; then
    extra_env="$extra_env --env $name=$value"
  fi
done

if [ "$#" -gt 0 ]; then
  # shellcheck disable=SC2086
  open -n -a "$bundle" --env "PAZEDO_PASEO_ENDPOINT=$endpoint" --env "PAZEDO_USER_DATA_DIR=$data_dir" \
    --env "PAZEDO_AGENT_PROVIDER=$provider" --env "PAZEDO_AGENT_MODEL=$model" $extra_env --args "$@"
else
  # shellcheck disable=SC2086
  open -n -a "$bundle" --env "PAZEDO_PASEO_ENDPOINT=$endpoint" --env "PAZEDO_USER_DATA_DIR=$data_dir" \
    --env "PAZEDO_AGENT_PROVIDER=$provider" --env "PAZEDO_AGENT_MODEL=$model" $extra_env
fi
echo "started $bundle (Paseo endpoint $endpoint, new agents: $provider/$model, data $data_dir)"
