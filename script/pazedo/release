#!/bin/sh
# Builds Pazedo.app on this Mac and uploads it, zipped, as a draft GitHub release.
#
#   GITHUB_TOKEN=… script/pazedo/release [--skip-build]
#
# The version is crates/zed/PAZEDO_VERSION and the tag is pazedo-v<version>. Bump the version
# and push it first: the release must be built from a commit that is on origin/main, with a
# clean working tree. The token needs write access to the repository's contents.
#
# The release is a draft, which only the repository's collaborators can see, and GitHub
# creates the tag when it is published. Check it on GitHub, then publish it there.
#
# --skip-build reuses target/release/Pazedo.app, as long as its remote servers were built from
# this commit (their version file names it).
#
# The app is ad-hoc signed, so macOS quarantines the download; the release notes say how to
# lift that.

set -eu

repo=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
build=true
for argument in "$@"; do
  case "$argument" in
    --skip-build) build=false ;;
    *) echo "unknown argument $argument" >&2; exit 1 ;;
  esac
done

cd "$repo"
token="${GITHUB_TOKEN:?set GITHUB_TOKEN to a token with write access to the repository contents}"
github_repo=$(git remote get-url origin | sed -E -e 's#^(https://github\.com/|git@github\.com:)##' -e 's#\.git$##')
version=$(tr -d '[:space:]' < crates/zed/PAZEDO_VERSION)
tag="pazedo-v$version"
commit=$(git rev-parse HEAD)

# The token goes to curl in a file, so it never shows in the process list.
authorization=$(mktemp)
trap 'rm -f "$authorization"' EXIT
printf 'Authorization: Bearer %s\n' "$token" > "$authorization"
# git gets it through the environment, for the same reason.
github_git() {
  GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=http.https://github.com/.extraHeader \
    GIT_CONFIG_VALUE_0="Authorization: Basic $(printf 'x-access-token:%s' "$token" | base64)" \
    git "$@"
}
github() {
  method=$1
  url=$2
  shift 2
  curl -sS --fail-with-body -X "$method" -H @"$authorization" \
    -H "Accept: application/vnd.github+json" -H "X-GitHub-Api-Version: 2022-11-28" \
    "$@" "$url"
}

if [ -n "$(git status --porcelain)" ]; then
  echo "the working tree has changes; commit and push them first" >&2
  exit 1
fi
github_git fetch --quiet origin main
if [ "$commit" != "$(git rev-parse origin/main)" ]; then
  echo "HEAD is not origin/main; push it (or check out origin/main) first" >&2
  exit 1
fi
if [ -n "$(github_git ls-remote --tags origin "refs/tags/$tag")" ]; then
  echo "$tag already exists; bump crates/zed/PAZEDO_VERSION" >&2
  exit 1
fi
# Drafts have no tag yet, so look for one by name.
if github GET "https://api.github.com/repos/$github_repo/releases?per_page=100" |
  TAG="$tag" python3 -c 'import json, os, sys; sys.exit(0 if any(r["tag_name"] == os.environ["TAG"] for r in json.load(sys.stdin)) else 1)'; then
  echo "a release for $tag already exists, perhaps as a draft; delete it on GitHub first" >&2
  exit 1
fi

app="$repo/target/release/Pazedo.app"
if $build; then
  script/pazedo/bundle
elif [ "$(cat "$app/Contents/Resources/remote_server/version" 2>/dev/null)" != "$(git rev-parse --short=12 HEAD)" ]; then
  echo "$app was not built from $commit; run without --skip-build" >&2
  exit 1
fi

archive="$repo/target/release/Pazedo-$version-macos-aarch64.zip"
rm -f "$archive"
# ditto keeps the code signature and extended attributes that zip would lose.
ditto -c -k --keepParent "$app" "$archive"

zed_version=$(sed -n 's/^version = "\(.*\)"/\1/p' crates/zed/Cargo.toml | head -n 1)
paseo_version=$(sed -n 's/^pub const PASEO_PROTOCOL_PACKAGE_VERSION: &str = "\(.*\)";/\1/p' crates/paseo_client/src/protocol.rs)
notes=$(cat <<NOTES
Pazedo $version for macOS on Apple silicon, built from \`$(git rev-parse --short=10 HEAD)\`.

| | |
| --- | --- |
| Zed | $zed_version-dev |
| Paseo protocol | $paseo_version |

Building Pazedo yourself is recommended; see the README. To use this build instead, unzip it,
move Pazedo.app to Applications, and lift macOS's quarantine, as the app is not notarized:

\`\`\`sh
xattr -dr com.apple.quarantine /Applications/Pazedo.app
\`\`\`

Pazedo doesn't update itself. Download a newer release to update.
NOTES
)

release=$(
  TAG="$tag" COMMIT="$commit" NAME="Pazedo $version" NOTES="$notes" python3 -c '
import json, os
print(json.dumps({
    "tag_name": os.environ["TAG"],
    "target_commitish": os.environ["COMMIT"],
    "name": os.environ["NAME"],
    "body": os.environ["NOTES"],
    "draft": True,
}))' | github POST "https://api.github.com/repos/$github_repo/releases" --data-binary @-
)
release_id=$(echo "$release" | python3 -c 'import json, sys; print(json.load(sys.stdin)["id"])')
release_url=$(echo "$release" | python3 -c 'import json, sys; print(json.load(sys.stdin)["html_url"])')

github POST "https://uploads.github.com/repos/$github_repo/releases/$release_id/assets?name=$(basename "$archive")" \
  -H "Content-Type: application/zip" --data-binary @"$archive" >/dev/null

echo "draft release $tag with $(basename "$archive"): $release_url"
echo "check it, then publish it on GitHub"
