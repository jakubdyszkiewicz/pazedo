#!/bin/sh
# Drives the dev build's window for end-to-end checks. Needs Accessibility permission for the
# app this runs under (Terminal.app on the Mac mini).
#
#   script/pazedo/ui key <key code> [modifiers]   # e.g. `ui key 53` (Escape), `ui key 36` (Return)
#   script/pazedo/ui type <text>                  # types text into the focused field
#   script/pazedo/ui click <x> <y>                # in screenshot coordinates (1600 px wide)
#   script/pazedo/ui right-click <x> <y>          # e.g. to open a context menu
#   script/pazedo/ui move <x> <y>                 # hover only, e.g. to reveal a row's buttons
#   script/pazedo/ui scroll <x> <y> <lines>       # negative lines scroll down
#   script/pazedo/ui frame                        # window position and size in points
set -eu

# PAZEDO_UI_PID picks another process, e.g. an installed Pazedo.app.
pid=${PAZEDO_UI_PID:-$(pgrep -n -f '(target/[a-z]+|PazedoDev.app/Contents/MacOS)/pazedo( |$)' || true)}
if [ -z "$pid" ]; then
  echo "no running target/*/pazedo process" >&2
  exit 1
fi
process="(first process whose unix id is $pid)"

frame() {
  osascript -e "tell application \"System Events\" to tell $process to get {position, size} of window 1" | tr -d ' '
}

# Raising an app that is already in front still re-activates it, which closes open popovers.
if [ "$(osascript -e "tell application \"System Events\" to get unix id of first process whose frontmost is true")" != "$pid" ]; then
  osascript -e "tell application \"System Events\" to set frontmost of $process to true" >/dev/null
  sleep 0.3
fi

case "${1:-}" in
  frame)
    frame
    ;;
  key)
    if [ -n "${3:-}" ]; then
      osascript -e "tell application \"System Events\" to key code $2 using {$3}"
    else
      osascript -e "tell application \"System Events\" to key code $2"
    fi
    ;;
  type)
    osascript -e "tell application \"System Events\" to keystroke \"$2\""
    ;;
  click|right-click|move|scroll)
    # Screenshots are scaled to 1600 px wide; convert to screen points within the window.
    IFS=, read -r left top width height <<FRAME
$(frame)
FRAME
    x=$(( left + $2 * width / 1600 ))
    y=$(( top + $3 * width / 1600 ))
    if [ "$1" = scroll ]; then
      swift "$(dirname -- "$0")/click.swift" --scroll "$4" "$x" "$y"
      echo "scrolled $4 at $x,$y"
    elif [ "$1" = move ]; then
      swift "$(dirname -- "$0")/click.swift" --move "$x" "$y"
      echo "moved to $x,$y"
    elif [ "$1" = right-click ]; then
      swift "$(dirname -- "$0")/click.swift" --right "$x" "$y"
      echo "right-clicked at $x,$y"
    else
      swift "$(dirname -- "$0")/click.swift" "$x" "$y"
      echo "clicked at $x,$y"
    fi
    ;;
  *)
    echo "usage: $0 frame | key <code> [modifiers] | type <text> | click|right-click|move <x> <y>" >&2
    exit 2
    ;;
esac
