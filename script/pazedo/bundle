#!/bin/sh
# Builds pazedo in release mode and wraps it in target/release/Pazedo.app.
#
#   script/pazedo/bundle                 # build and bundle
#   script/pazedo/bundle --skip-build    # bundle the existing target/release/pazedo
#   script/pazedo/bundle --install       # also copy it to ~/Applications/Pazedo.app
#
# Leaner than Zed's script/bundle-mac, which also builds the CLI, fetches cargo-bundle and git,
# signs with Zed's identity and makes a DMG. This bundle is ad-hoc signed
# for this machine only. Install it rather than running it from target/: target/ lives on the
# external disk, and Zed offers to "move it to Applications" whenever it runs from /Volumes.
#
# The app keeps its own folders, Zed's layout under its own name (`paths::APP_NAME` is "Pazedo"):
# settings and keymap in ~/.config/pazedo, data in ~/Library/Application Support/Pazedo, logs in
# ~/Library/Logs/Pazedo. It shares nothing with an installed Zed. Development builds started with
# script/pazedo/run-dev use a data directory of their own (PAZEDO_USER_DATA_DIR).
#
# The daemon to connect to is a setting, in the app's own settings.json
# (~/.config/pazedo/settings.json):
#   "paseo": { "endpoint": "100.64.0.1:6767" }
#
# Zed's remote servers for the platforms in PAZEDO_REMOTE_SERVER_TARGETS (Linux x86_64 and Apple
# Silicon macOS by default) go into Contents/Resources/remote_server, built by
# script/pazedo/remote-server; the app uploads the matching one to SSH hosts. --skip-build
# reuses the servers built last time. The version file names the build, so hosts get a new
# server whenever the app changes.
#
# The app stays on the "dev" release channel, which never auto-updates; an update from Zed's
# servers would replace the fork with upstream Zed.

set -eu

repo=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
build=true
install=false
for argument in "$@"; do
  case "$argument" in
    --skip-build) build=false ;;
    --install) install=true ;;
    *) echo "unknown argument $argument" >&2; exit 1 ;;
  esac
done

cd "$repo"
remote_server_targets="${PAZEDO_REMOTE_SERVER_TARGETS:-x86_64-unknown-linux-musl aarch64-apple-darwin}"
remote_servers="$repo/target/remote_server/bundle"
if $build; then
  ZED_UPDATE_EXPLANATION="pazedo is built from source with script/pazedo/bundle." \
    cargo build --release --package zed
  rm -rf "$remote_servers"
  for triple in $remote_server_targets; do
    script/pazedo/remote-server "$triple" "$remote_servers/$(
      echo "$triple" | sed -e 's/^\([^-]*\)-.*-linux-.*/linux-\1/' -e 's/^\([^-]*\)-apple-darwin$/macos-\1/'
    ).gz"
  done
  if git diff --quiet HEAD; then
    git rev-parse --short=12 HEAD > "$remote_servers/version"
  else
    echo "$(git rev-parse --short=12 HEAD)-$(date +%Y%m%d%H%M%S)" > "$remote_servers/version"
  fi
fi

binary="$repo/target/release/pazedo"
app="$repo/target/release/Pazedo.app"
if [ ! -x "$binary" ]; then
  echo "$binary not found" >&2
  exit 1
fi

rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp "$binary" "$app/Contents/MacOS/pazedo"

iconset=$(mktemp -d)/Pazedo.iconset
mkdir -p "$iconset"
for size in 16 32 128 256 512; do
  sips -z "$size" "$size" crates/zed/resources/app-icon-dev@2x.png \
    --out "$iconset/icon_${size}x${size}.png" >/dev/null
  double=$((size * 2))
  sips -z "$double" "$double" crates/zed/resources/app-icon-dev@2x.png \
    --out "$iconset/icon_${size}x${size}@2x.png" >/dev/null
done
iconutil -c icns "$iconset" -o "$app/Contents/Resources/Pazedo.icns"
cp crates/zed/resources/Document.icns "$app/Contents/Resources/Document.icns"
if [ -f "$remote_servers/version" ]; then
  cp -R "$remote_servers" "$app/Contents/Resources/remote_server"
else
  echo "no remote servers in $remote_servers; SSH projects will need one installed by hand" >&2
fi

version=$(sed -n 's/^version = "\(.*\)"/\1/p' crates/zed/Cargo.toml | head -n 1)
{
  cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key><string>pazedo</string>
  <key>CFBundleIdentifier</key><string>dev.pazedo.Pazedo</string>
  <key>CFBundleName</key><string>Pazedo</string>
  <key>CFBundleDisplayName</key><string>Pazedo</string>
  <key>CFBundleIconFile</key><string>Pazedo</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$version</string>
  <key>CFBundleVersion</key><string>$(git rev-parse --short HEAD)</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.developer-tools</string>
  <key>LSMinimumSystemVersion</key><string>12.0</string>
  <key>NSHighResolutionCapable</key><true/>
PLIST
  # Zed's own plist fragments: document types and the usage descriptions that programs run in
  # its terminal need for macOS permission prompts.
  cat crates/zed/resources/info/*.plist
  cat <<PLIST
</dict>
</plist>
PLIST
} > "$app/Contents/Info.plist"
plutil -lint "$app/Contents/Info.plist" >/dev/null

codesign --force --deep --sign - "$app"
echo "bundled $app"

if $install; then
  destination="$HOME/Applications/Pazedo.app"
  mkdir -p "$HOME/Applications"
  if pgrep -f "$destination/Contents/MacOS/" >/dev/null; then
    echo "quit the running $destination first" >&2
    exit 1
  fi
  rm -rf "$destination"
  ditto "$app" "$destination"
  # LaunchServices caches Info.plist.
  /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$destination"
  echo "installed $destination"
fi
