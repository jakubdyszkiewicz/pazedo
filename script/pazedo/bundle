#!/bin/sh
# Builds pazedo in release mode and wraps it in target/release/Pazedo.app.
#
#   script/pazedo/bundle                 # build and bundle
#   script/pazedo/bundle --skip-build    # bundle the existing target/release/zed
#   script/pazedo/bundle --install       # also copy it to ~/Applications/Pazedo.app
#
# Leaner than Zed's script/bundle-mac, which also builds the CLI and the remote server, fetches
# cargo-bundle and git, signs with Zed's identity and makes a DMG. This bundle is ad-hoc signed
# for this machine only. Install it rather than running it from target/: target/ lives on the
# external disk, and Zed offers to "move it to Applications" whenever it runs from /Volumes.
#
# The app keeps its own data under ~/Library/Application Support/Pazedo (PAZEDO_USER_DATA_DIR,
# read by crates/zed/src/main.rs like --user-data-dir), so it shares no settings, databases or
# running instance with a dev build or an installed Zed. Both variables are set with
# LSEnvironment in Info.plist: a launcher script that execs zed instead hides the app's windows
# from System Events and other accessibility clients.
#
# The app stays on the "dev" release channel, which never auto-updates; an update from Zed's
# servers would replace the fork with upstream Zed.
#
# Until pazedo has a setting for it, the daemon endpoint is fixed when bundling:
# PAZEDO_PASEO_ENDPOINT (default: the test daemon, 127.0.0.1:6868).
set -eu

repo=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
endpoint="${PAZEDO_PASEO_ENDPOINT:-127.0.0.1:6868}"
build=true
install=false
for argument in "$@"; do
  case "$argument" in
    --skip-build) build=false ;;
    --install) install=true ;;
    *) echo "unknown argument $argument" >&2; exit 1 ;;
  esac
done

cd "$repo"
if $build; then
  ZED_UPDATE_EXPLANATION="pazedo is built from source with script/pazedo/bundle." \
    cargo build --release --package zed
fi

binary="$repo/target/release/zed"
app="$repo/target/release/Pazedo.app"
if [ ! -x "$binary" ]; then
  echo "$binary not found" >&2
  exit 1
fi

rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp "$binary" "$app/Contents/MacOS/zed"

iconset=$(mktemp -d)/Pazedo.iconset
mkdir -p "$iconset"
for size in 16 32 128 256 512; do
  sips -z "$size" "$size" crates/zed/resources/app-icon-dev@2x.png \
    --out "$iconset/icon_${size}x${size}.png" >/dev/null
  double=$((size * 2))
  sips -z "$double" "$double" crates/zed/resources/app-icon-dev@2x.png \
    --out "$iconset/icon_${size}x${size}@2x.png" >/dev/null
done
iconutil -c icns "$iconset" -o "$app/Contents/Resources/Pazedo.icns"
cp crates/zed/resources/Document.icns "$app/Contents/Resources/Document.icns"

version=$(sed -n 's/^version = "\(.*\)"/\1/p' crates/zed/Cargo.toml | head -n 1)
{
  cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key><string>zed</string>
  <key>CFBundleIdentifier</key><string>dev.pazedo.Pazedo</string>
  <key>CFBundleName</key><string>Pazedo</string>
  <key>CFBundleDisplayName</key><string>Pazedo</string>
  <key>CFBundleIconFile</key><string>Pazedo</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$version</string>
  <key>CFBundleVersion</key><string>$(git rev-parse --short HEAD)</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.developer-tools</string>
  <key>LSMinimumSystemVersion</key><string>12.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>LSEnvironment</key>
  <dict>
    <key>PAZEDO_PASEO_ENDPOINT</key><string>$endpoint</string>
    <key>PAZEDO_USER_DATA_DIR</key><string>$HOME/Library/Application Support/Pazedo</string>
  </dict>
PLIST
  # Zed's own plist fragments: document types and the usage descriptions that programs run in
  # its terminal need for macOS permission prompts.
  cat crates/zed/resources/info/*.plist
  cat <<PLIST
</dict>
</plist>
PLIST
} > "$app/Contents/Info.plist"
plutil -lint "$app/Contents/Info.plist" >/dev/null

codesign --force --deep --sign - "$app"
echo "bundled $app (Paseo endpoint $endpoint)"

if $install; then
  destination="$HOME/Applications/Pazedo.app"
  mkdir -p "$HOME/Applications"
  if pgrep -f "$destination/Contents/MacOS/zed" >/dev/null; then
    echo "quit the running $destination first" >&2
    exit 1
  fi
  rm -rf "$destination"
  ditto "$app" "$destination"
  # LaunchServices caches Info.plist, including LSEnvironment.
  /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$destination"
  echo "installed $destination"
fi
